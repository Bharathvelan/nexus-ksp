# ==========================================
# NEXUS-KSP Environment Variables
# ==========================================

# PostgreSQL Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=nexus_secure_pass
POSTGRES_DB=nexus_ksp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Neo4j Config
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus_secure_pass

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Config
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Kafka Config
KAFKA_BROKER=localhost:9092

# Keycloak Config
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nexus-ksp
KEYCLOAK_CLIENT_ID=web-app
KEYCLOAK_CLIENT_SECRET=super_secret_keycloak_secret

# AI Models & Services
OPENAI_API_KEY=your_openai_key_here
WHISPER_MODEL=openai/whisper-large-v3
INDIC_TRANS_MODEL=ai4bharat/indictrans2-kn-en-1B

# Security
ENCRYPTION_KEY=32_byte_hex_string_for_pgcrypto

# Service Ports
PORT_LLM_ORCHESTRATOR=8001
PORT_GRAPH_SERVICE=8002
PORT_PATTERN_ENGINE=8003
PORT_PROFILING_SERVICE=8004
PORT_ALERT_SERVICE=8005
PORT_AUDIT_LOGGER=8006
PORT_REPORT_EXPORTER=8007
PORT_WEB_DASHBOARD=3000
